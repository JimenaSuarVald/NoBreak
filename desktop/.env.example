# Configuración local de NoBreak.
# Copia este archivo a `.env` (en `desktop/`) y rellena los valores. El
# archivo `.env` está en .gitignore — no se sube al repo. Nunca subas tus
# claves al control de versiones.

# --- Last.fm (credenciales de la APP, no del usuario) -------------------
# Estas son las credenciales de DESARROLLADOR de la aplicación: la API key
# + Shared Secret que Last.fm te da al registrar la app en
# https://www.last.fm/api/account/create. El usuario final NUNCA verá
# estos valores ni necesitará introducirlos — sólo su usuario y contraseña
# de Last.fm para iniciar sesión. Sin estas dos variables el panel de
# Last.fm en Ajustes queda desactivado.
LASTFM_API_KEY=TU_API_KEY_AQUI
LASTFM_SHARED_SECRET=TU_SHARED_SECRET_AQUI

# --- MusicBrainz / MetaBrainz -------------------------------------------
# Token de acceso opcional. Las lecturas (releases, artists, tags) no lo
# requieren — sólo se mandan con el User-Agent. Si configuras una clave,
# se envía como Authorization: Bearer para futuros endpoints autenticados.
MUSICBRAINZ_API_KEY=TU_API_KEY_AQUI

# User-Agent que se manda a MusicBrainz. Su política exige uno identificable.
# Recomendado: NombreApp/Version (contacto). Cámbialo si lo prefieres.
MUSICBRAINZ_USER_AGENT=NoBreak/0.1 (asuarez@suarezvaldes.es)
